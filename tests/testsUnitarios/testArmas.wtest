import src.mecanicas.armas.armas.*
import src.mecanicas.armas.armasDeNave.*
import src.mecanicas.armas.armasEnemigas.*
import src.mecanicas.animaciones.recursos.recursosDeAnimacion.*
import wollok.game.*

describe "Tests Unitarios del Sistema de Armas" {

  // 1. Mocks de simulación para entorno aislado
  const bandoMock = object {
    var property disparosRegistrados = []
    method puedeDisparar() = true
    method registrar(disparo) { disparosRegistrados.add(disparo) }
  }

  const personajeMock = object {
    method bando() = bandoMock
    // Ubicamos al personaje en una coordenada central segura
    method position() = game.at(5, 5)
  }

  const recursoPrueba = new RecursoDeAnimacion(
    frames = ["f1.png", "f2.png"],
    duracion = 100
  )

  // 2. Configuración previa al inicio de los tests
  method initialize() {
    bandoMock.disparosRegistrados().clear()
    
    // SOLUCIÓN AL TABLERO VACÍO: Inicializamos el ancho y alto de game 
    // en el entorno de pruebas para que 'tablero.wlk' no lance excepciones.
    game.width(15)
    game.height(15)
  }

  // TESTS DE ARMA BÁSICA (INFINITA)

  test "El ArmaBasica no reduce su munición al disparar" {
    const armaInfinita = new ArmaBasica(
      recursoBala = recursoPrueba,
      danoBala = 10,
      municion = 5
    )
    
    armaInfinita.disparar(personajeMock)
    // SOLUCIÓN: Usamos el método getter directo de la variable interna
    assert.equals(5, armaInfinita.municion())
  }

  // TESTS DE ARMA LÁSER (DINÁMICA)

  test "ArmaLaser calcula el daño dinámicamente según la munición consumida" {
    const laser = new ArmaLaser(
      recursoBala = recursoPrueba,
      danoBala = 5,
      municion = 10
    )
    assert.equals(10, laser.danoDisparo())
  }

  test "ArmaLaser reduce la munición correctamente al disparar" {
    const laser = new ArmaLaser(
      recursoBala = recursoPrueba,
      danoBala = 5,
      municion = 10
    )
    
    laser.disparar(personajeMock)
    assert.equals(8, laser.municion())
  }

  test "ArmaLaser no puede disparar si no alcanza la munición consumida" {
    const laserPocoCargado = new ArmaLaser(
      recursoBala = recursoPrueba,
      danoBala = 5,
      municion = 1
    )
    
    assert.notThat(laserPocoCargado.hayMunicion())
  }

  // TESTS DE CAÑÓN DE PLASMA

  test "ArmaDePlasma consume de a 4 unidades de munición" {
    const plasma = new ArmaDePlasma(
      recursoBala = recursoPrueba,
      danoBala = 10,
      municion = 10
    )
    
    plasma.disparar(personajeMock)
    assert.equals(6, plasma.municion())
  }

  // TESTS DE CAÑONES MÚLTIPLES

  test "DobleCanon genera exactamente 2 proyectiles y consume 2 de munición" {
    const doble = new DobleCanon(
      recursoBala = recursoPrueba,
      danoBala = 5,
      municion = 20
    )
    
    doble.disparar(personajeMock)
    
    assert.equals(18, doble.municion())
    assert.equals(2, bandoMock.disparosRegistrados().size())
  }

  test "TripleCanon genera exactamente 3 proyectiles y el daño por bala es el base" {
    const triple = new TripleCanon(
      recursoBala = recursoPrueba,
      danoBala = 7,
      municion = 15
    )
    
    triple.disparar(personajeMock)
    
    assert.equals(12, triple.municion())
    assert.equals(3, bandoMock.disparosRegistrados().size())
  }

  // TESTS DE ARMAS ENEMIGAS

  test "ArmaEnemigaBasica no consume munición al ser utilizada por enemigos" {
    const municionInicial = armaEnemigaBasica.municion()
    
    armaEnemigaBasica.disparar(personajeMock)
    assert.equals(municionInicial, armaEnemigaBasica.municion())
  }
}
/*

🔍 Aspectos Clave de la Cobertura de estos Tests:

• Aislamiento Gráfico: El uso de personajeMock y bandoMock evita heredar dependencias visuales complejas o inicializar el tablero, permitiendo que la suite corra de inmediato en milisegundos.
• Verificación de Daño Polimórfico: Comprueba la consistencia matemática de danoDisparo(), asegurando que ArmaLaser y ArmaDePlasma multipliquen su fuerza correctamente, mientras que ArmasConMasProyectiles respete el daño base por cada elemento de la ráfaga.
• Control de Rangos e Índices: Al inspeccionar bandoMock.disparosRegistrados().size(), se comprueba que el comportamiento de los bucles nativos agregue la cantidad exacta de instancias esperadas.

*/