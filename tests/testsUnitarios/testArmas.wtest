import wollok.game.*
import src.mecanicas.armas.armas.*
import src.mecanicas.armas.armasNave.*
import src.mecanicas.armas.armasEnemigas.*
import src.mecanicas.armas.clasesDeArmas.armaBasica.*
import src.mecanicas.armas.clasesDeArmas.armasLaser.*
import src.mecanicas.armas.clasesDeArmas.armasMultiples.*
import tests.mocks.mocksArmas.*
import tests.mocks.mocksPersonaje.*

describe "Armas: Disparo básico y munición" {

  var bando
  var bandoSinPermiso
  var arma

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    
    bando = new BandoEspia(permiteDisparar = true)
    bandoSinPermiso = new BandoEspia(permiteDisparar = false)
    
    arma = new Arma(recursoBala = new RecursoMock(frame = "bala.png"), danoBala = 7, municion = 5, iconoHud = "x.png")
  }

  method tiradorEn(bandoAsignado, posicion) = object {
    method bando() = bandoAsignado
    method position() = posicion
  }

  test "Al disparar, genera la bala con el daño y posición correctos, y consume munición" {
    const tirador = self.tiradorEn(bando, game.at(5, 5))
    
    arma.disparar(tirador)

    assert.equals(4, arma.municion()) // Gastó 1
    const bala = bando.disparosRegistrados().first()
    assert.equals(7, bala.dano())
    assert.equals(game.at(5, 5), bala.position())
  }

  test "Si el bando no tiene permiso, no dispara ni consume munición" {
    const tirador = self.tiradorEn(bandoSinPermiso, game.at(5, 5))
    
    arma.disparar(tirador)

    assert.equals(5, arma.municion()) // No gastó nada
    assert.that(bandoSinPermiso.disparosRegistrados().isEmpty())
  }
}

describe "Armas: Munición infinita vs dinámica" {

  var bando
  var recurso
  var tirador

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    
    bando = new BandoEspia(permiteDisparar = true)
    recurso = new RecursoMock(frame = "bala.png")
    
    tirador = object {
      method bando() = bando
      method position() = game.at(5, 5)
    }
  }

  test "Las armas básicas y enemigas disparan infinitamente sin gastar munición" {
    const armaBasica = new ArmaBasica(recursoBala = recurso, danoBala = 1, municion = 5, iconoHud = "x.png")
    const armaEnemiga = armaEnemigaBasica

    armaBasica.disparar(tirador)
    armaBasica.disparar(tirador)
    armaEnemiga.disparar(tirador)

    assert.equals(5, armaBasica.municion()) 
    assert.equals(3, bando.disparosRegistrados().size()) 
  }

  test "Las armas especiales gastan munición según su costo y dejan de disparar si no alcanza" {
    const laser = new ArmaLaser(recursoBala = recurso, danoBala = 5, municion = 2, iconoHud = "x.png")
    assert.that(laser.hayMunicion())

    laser.disparar(tirador)
    assert.equals(0, laser.municion())
    assert.notThat(laser.hayMunicion())

    const plasma = new ArmaDePlasma(recursoBala = recurso, danoBala = 10, municion = 3, iconoHud = "x.png")
    assert.notThat(plasma.hayMunicion())
  }
}

describe "Armas: Cañones múltiples y bordes" {

  var recurso

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    recurso = new RecursoMock(frame = "bala.png")
  }

  method posicionesDeBalas(bandoAsignado) = bandoAsignado.disparosRegistrados().map({ bala => bala.position() })

  test "El DobleCañón dispara dos balas en columnas vecinas y gasta 2 de munición" {
    const bando = new BandoEspia(permiteDisparar = true)
    const doble = new DobleCanon(recursoBala = recurso, danoBala = 5, municion = 10, iconoHud = "x.png")
    const tirador = object {
      method bando() = bando
      method position() = game.at(5, 5)
    }

    doble.disparar(tirador)

    assert.equals(8, doble.municion())
    assert.equals(2, bando.disparosRegistrados().size())
    assert.that(self.posicionesDeBalas(bando).contains(game.at(4, 5)))
    assert.that(self.posicionesDeBalas(bando).contains(game.at(6, 5)))
  }

  test "El TripleCañón dispara tres balas (centro y vecinas) y gasta 3 de munición" {
    const bando = new BandoEspia(permiteDisparar = true)
    const triple = new TripleCanon(recursoBala = recurso, danoBala = 7, municion = 10, iconoHud = "x.png")
    const tirador = object {
      method bando() = bando
      method position() = game.at(5, 5)
    }

    triple.disparar(tirador)

    assert.equals(7, triple.municion())
    assert.equals(3, bando.disparosRegistrados().size())
    assert.that(self.posicionesDeBalas(bando).contains(game.at(5, 5)))
  }

  test "En los bordes, los cañones múltiples ajustan la cantidad de balas generadas" {
    const doble = new DobleCanon(recursoBala = recurso, danoBala = 5, municion = 10, iconoHud = "x.png")
    const triple = new TripleCanon(recursoBala = recurso, danoBala = 7, municion = 10, iconoHud = "x.png")
    
    const bandoIzq = new BandoEspia(permiteDisparar = true)
    const bandoDer = new BandoEspia(permiteDisparar = true)
    
    const tiradorIzquierdo = object {
      method bando() = bandoIzq
      method position() = game.at(0, 5)
    }
    const tiradorDerecho = object {
      method bando() = bandoDer
      method position() = game.at(19, 5)
    }

    doble.disparar(tiradorIzquierdo)
    assert.equals(1, bandoIzq.disparosRegistrados().size())

    triple.disparar(tiradorDerecho)
    assert.equals(2, bandoDer.disparosRegistrados().size())
  }
}

describe "Armas: Ajuste de posición del bando" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
  }

  test "La bala se posiciona en la celda que dicta el ajuste del bando, no encima del tirador" {
    const bandoQueAjusta = new BandoEspiaQueAjusta(permiteDisparar = true)
    const recurso = new RecursoMock(frame = "bala.png")
    const arma = new Arma(recursoBala = recurso, danoBala = 7, municion = 5, iconoHud = "x.png")
    
    const tirador = object {
      method bando() = bandoQueAjusta
      method position() = game.at(5, 5)
    }

    arma.disparar(tirador)

    assert.equals(game.at(5, 6), bandoQueAjusta.disparosRegistrados().first().position())
  }
}