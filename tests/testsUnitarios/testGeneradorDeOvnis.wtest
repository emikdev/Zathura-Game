import wollok.game.*
import src.mecanicas.direcciones.*
import src.mecanicas.bandos.*
import src.mecanicas.gestores.generadorOvnis.*

describe "Generador de ovnis: lanzamiento determinista" {

  method initialize() {
    game.width(20)
    game.height(20)
  }

  test "si va hacia la derecha nace en la primera columna, en la fila más alta de la zona jugable" {
    const ovniNuevo = generadorOvnis.lanzarDesde(true)

    assert.equals(game.at(0, tablero.filaMaxima()), ovniNuevo.position())
  }

  test "si va hacia la izquierda nace en la última columna, en la fila más alta de la zona jugable" {
    const ovniNuevo = generadorOvnis.lanzarDesde(false)

    assert.equals(game.at(19, tablero.filaMaxima()), ovniNuevo.position())
  }

  test "el ovni lanzado queda en el tablero" {
    const ovniNuevo = generadorOvnis.lanzarDesde(true)

    assert.that(game.hasVisual(ovniNuevo))
  }

  test "el ovni pertenece al bando enemigo y nace con salud" {
    const ovniNuevo = generadorOvnis.lanzarDesde(true)

    assert.equals(enemigo, ovniNuevo.bando())
    assert.notThat(ovniNuevo.sinSalud())
  }

  test "cada lanzamiento crea un ovni distinto" {
    const uno = generadorOvnis.lanzarDesde(true)
    const otro = generadorOvnis.lanzarDesde(true)

    assert.notEquals(uno, otro)
    assert.that(game.hasVisual(uno))
    assert.that(game.hasVisual(otro))
  }

  test "la posición de salida se adapta al ancho del tablero" {
    game.width(10)

    const ovniNuevo = generadorOvnis.lanzarDesde(false)

    assert.equals(9, ovniNuevo.position().x())
  }
}

describe "Generador de ovnis: reloj" {

  test "iniciar y luego detener no falla" {
    generadorOvnis.iniciar()

    assert.doesNotThrowException({ generadorOvnis.detener() })
  }
}