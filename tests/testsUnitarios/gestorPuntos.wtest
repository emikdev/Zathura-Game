import wollok.game.*
import src.gestores.gestorDePuntos.*

describe "Tests del Gestor de Puntaje" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(10)
    gestorPuntaje.reiniciar()
  }

  // Acumulacion de puntos

  test "Sumar puntos incrementa el puntaje correctamente" {
    gestorPuntaje.sumar(25)
    gestorPuntaje.sumar(100)
    
    assert.equals(125, gestorPuntaje.puntos())
  }

  test "Reiniciar deja el puntaje en cero" {
    gestorPuntaje.sumar(500)
    gestorPuntaje.reiniciar()

    assert.equals(0, gestorPuntaje.puntos())
  }

  // Reglas de marcador

  test "El marcador solo muestra los últimos 4 dígitos (10000 vuelve a 0000)" {
    // Valida el límite de la UI. No es matemática pura, es una regla del juego.
    gestorPuntaje.sumar(10000)

    assert.equals(0, mil.numero())
    assert.equals(0, centena.numero())
    assert.equals(0, decena.numero())
    assert.equals(0, unidad.numero())
    assert.equals(10000, gestorPuntaje.puntos())
  }

  // Mostrar en pantalla

  test "Mostrar agrega los 4 dígitos y el cartel de score" {
    gestorPuntaje.mostrar()

    assert.that(game.allVisuals().contains(mil))
    assert.that(game.allVisuals().contains(centena))
    assert.that(game.allVisuals().contains(decena))
    assert.that(game.allVisuals().contains(unidad))
    assert.equals(5, game.allVisuals().size()) // 4 dígitos + 1 cartel
  }

  test "Los dígitos se actualizan automáticamente al sumar puntos sin volver a llamar a mostrar" {
    // Valida que el HUD reacciona dinámicamente al estado del gestor
    gestorPuntaje.mostrar()
    gestorPuntaje.sumar(42)

    assert.equals("numero_4.png", decena.image())
    assert.equals("numero_2.png", unidad.image())
  }
  
  test "Reiniciar el puntaje no quita los dígitos de la pantalla" {
    gestorPuntaje.mostrar()
    gestorPuntaje.reiniciar()

    assert.equals(5, game.allVisuals().size())
  }
}