import wollok.game.*
import src.niveles.nivel.*
import src.niveles.disposicion.*
import src.gestores.gestorMuros.*
import src.gestores.gestorNiveles.*
import src.menu.configuracion.*
import src.personajes.factory.tiposPersonajes.tiposDeEnemigos.*
import tests.mocks.mocksNivel.*
import src.gestores.reloj.*

describe "Nivel: Ciclo de vida" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    gestorMuros.detener()
    gestorNiveles.reiniciar()
    reloj.limpiarTodo()
  }

  // Inicio del nivel

  test "Al iniciar, crea los muros y coloca a los enemigos de la primera formación en el tablero" {
    configuracion.dificultadElegida(1)
    configuracion.cantidadJugadores(1)
    
    const disp = new DisposicionMock(celdas = [
      [pulpo, game.at(5, 10)],
      [calamar, game.at(6, 10)]
    ])
    const nivel = new Nivel(disposiciones = [disp])

    nivel.iniciar()

    assert.that(gestorMuros.cantidadActivos() > 0)
    assert.that(game.allVisuals().any({ v => v.position() == game.at(5, 10) }))
    assert.that(game.allVisuals().any({ v => v.position() == game.at(6, 10) }))
  }

  // Transición entre formaciones

  test "Al vaciarse una formación, si hay más pendientes, se coloca la siguiente en el tablero" {
    const disp1 = new DisposicionMock(celdas = [ [pulpo, game.at(3, 12)] ])
    const disp2 = new DisposicionMock(celdas = [ [alien, game.at(7, 14)] ])
    const nivel = new Nivel(disposiciones = [disp1, disp2])

    nivel.iniciar()
    
    // Usamos el nuevo método semántico
    nivel.limpiarFormacionActual()

    assert.that(game.allVisuals().any({ v => v.position() == game.at(7, 14) }))
  }

  // Fin del nivel

  test "Al vaciarse la última formación, se termina el nivel y se detienen los muros" {
    const nivel = new Nivel(disposiciones = [new DisposicionMock(celdas = [ [pulpo, game.at(5, 10)] ])])
    nivel.iniciar()
    assert.that(gestorMuros.cantidadActivos() > 0)

    nivel.limpiarFormacionActual()

    assert.equals(0, gestorMuros.cantidadActivos())
  }
}