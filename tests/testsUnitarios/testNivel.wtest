import wollok.game.*
import src.niveles.nivel.*
import src.niveles.disposicion.*
import src.mecanicas.gestores.gestorDeMuros.*
import src.mecanicas.gestores.gestorNiveles.*
import src.menu.configuracion.*
import src.personajes.factory.tiposPersonajes.tiposDeEnemigos.*
import tests.mocks.mocksNivel.*

describe "Nivel: estado inicial y consulta de formaciones" {

  const disp1 = new DisposicionMock()
  const disp2 = new DisposicionMock()
  const disp3 = new DisposicionMock()

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
  }

  test "al instanciarse, la formación actual es la primera de la lista" {
    const nivel = new Nivel(formaciones = [disp1, disp2])

    assert.equals(disp1, nivel.formacionActual())
  }

  test "un nivel con una sola formación no tiene formaciones pendientes" {
    const nivel = new Nivel(formaciones = [disp1])

    assert.notThat(nivel.hayFormacionesPendientes())
  }

  test "un nivel con múltiples formaciones tiene formaciones pendientes al inicio" {
    const nivel = new Nivel(formaciones = [disp1, disp2, disp3])

    assert.that(nivel.hayFormacionesPendientes())
  }
}

describe "Nivel: inicio del nivel (iniciar)" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    gestorMuros.detener()
    gestorNiveles.reiniciar()
  }

  test "iniciar inicializa los muros según la dificultad configurada" {
    configuracion.dificultadElegida(1)
    configuracion.cantidadJugadores(1)
    const nivel = new Nivel(formaciones = [new DisposicionMock()])

    nivel.iniciar()

    assert.that(gestorMuros.cantidadActivos() > 0)
    gestorMuros.detener()
  }

  test "iniciar agrega al tablero los enemigos de la primera formación" {
    const disp = new DisposicionMock(celdas = [
      [pulpo, game.at(5, 10)],
      [calamar, game.at(6, 10)]
    ])
    const nivel = new Nivel(formaciones = [disp])

    nivel.iniciar()

    assert.that(game.allVisuals().any({ v => v.position() == game.at(5, 10) }))
    assert.that(game.allVisuals().any({ v => v.position() == game.at(6, 10) }))
    gestorMuros.detener()
  }

  test "iniciar reinicia el progreso a la primera formación si ya se había avanzado" {
    const disp1 = new DisposicionMock()
    const disp2 = new DisposicionMock()
    const nivel = new Nivel(formaciones = [disp1, disp2])

    nivel.formacionVacia()
    assert.equals(disp2, nivel.formacionActual())

    nivel.iniciar()
    assert.equals(disp1, nivel.formacionActual())
    gestorMuros.detener()
  }
}

describe "Nivel: transición entre formaciones (formacionVacia)" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    gestorMuros.detener()
    gestorNiveles.reiniciar()
  }

  test "al vaciarse una formación habiendo pendientes, avanza a la siguiente formación" {
    const disp1 = new DisposicionMock()
    const disp2 = new DisposicionMock()
    const nivel = new Nivel(formaciones = [disp1, disp2])

    nivel.formacionVacia()

    assert.equals(disp2, nivel.formacionActual())
  }

  test "tras avanzar a la última formación, ya no quedan formaciones pendientes" {
    const disp1 = new DisposicionMock()
    const disp2 = new DisposicionMock()
    const nivel = new Nivel(formaciones = [disp1, disp2])

    nivel.formacionVacia()

    assert.notThat(nivel.hayFormacionesPendientes())
  }

  test "en un nivel de tres formaciones, tras avanzar a la segunda aún quedan pendientes" {
    const disp1 = new DisposicionMock()
    const disp2 = new DisposicionMock()
    const disp3 = new DisposicionMock()
    const nivel = new Nivel(formaciones = [disp1, disp2, disp3])

    nivel.formacionVacia()

    assert.equals(disp2, nivel.formacionActual())
    assert.that(nivel.hayFormacionesPendientes())
  }

  test "al avanzar de formación se colocan los enemigos de la nueva formación en el tablero" {
    const disp1 = new DisposicionMock(celdas = [ [pulpo, game.at(3, 12)] ])
    const disp2 = new DisposicionMock(celdas = [ [alien, game.at(7, 14)] ])
    const nivel = new Nivel(formaciones = [disp1, disp2])

    nivel.iniciar()
    nivel.formacionVacia()
    // No se mira que no quede el enemigo de la formacion anterior por que la unica forma de pasar de formacione s que quede vacia.
    assert.that(game.allVisuals().any({ v => v.position() == game.at(7, 14) }))
    gestorMuros.detener()
  }
}

describe "Nivel: finalización del nivel (nivelTerminado)" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    gestorMuros.detener()
    gestorNiveles.reiniciar()
  }

  test "nivelTerminado detiene el gestor de muros y retira sus visuales" {
    const nivel = new Nivel(formaciones = [new DisposicionMock()])
    nivel.iniciar()
    assert.that(gestorMuros.cantidadActivos() > 0)

    nivel.nivelTerminado()

    assert.equals(0, gestorMuros.cantidadActivos())
  }

  test "cuando se vacía la última formación se dispara la finalización del nivel" {
    const nivel = new Nivel(formaciones = [new DisposicionMock()])
    nivel.iniciar()

    nivel.formacionVacia()

    assert.equals(0, gestorMuros.cantidadActivos())
  }

  test "al terminar el nivel se notifica al gestor de niveles" {
    const nivel = new Nivel(formaciones = [new DisposicionMock()])
    nivel.iniciar()

    nivel.nivelTerminado()
    nivel.nivelTerminado()
    nivel.nivelTerminado()
    nivel.nivelTerminado()
    assert.that(game.allVisuals().any({ v => v.image() == "ganaste.png" }))
  }
}
