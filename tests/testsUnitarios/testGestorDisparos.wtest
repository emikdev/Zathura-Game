import wollok.game.*
import src.gestores.gestorDisparos.*
import src.mecanicas.bandos.bandoJugador.*
import src.mecanicas.bandos.bandoEnemigo.*
import tests.mocks.mocksPersonaje.*

describe "Gestor de disparos" {

  var unDisparoEnemigo

  method initialize() {
    // Ahora sí, limpiamos usando el método que agregaste
    gestorEnemigos.limpiar()
    gestorJugador.limpiar()
    
    unDisparoEnemigo = new DisparoMock(bando = enemigo, dano = 1)
  }

  test "El gestor enemigo respeta su límite máximo en pantalla y libera espacio al destruirse" {
    const disparosCreados = []
    
    // Llenamos el gestor hasta el tope guardando las referencias
    gestorEnemigos.limiteMaximo().times({ i => 
      const d = new DisparoMock(bando = enemigo, dano = 1)
      gestorEnemigos.registrarDisparo(d) 
      disparosCreados.add(d)
    })
    
    // Ya no puede disparar
    assert.notThat(gestorEnemigos.puedeDisparar())

    // Al liberar (destruir) el primer disparo de la lista, se libera un lugar
    gestorEnemigos.liberarDisparo(disparosCreados.first())
    assert.that(gestorEnemigos.puedeDisparar())
  }

  test "No se permiten registros duplicados y liberar uno inexistente no rompe el gestor" {
    // Intentamos registrar el mismo disparo dos veces
    gestorEnemigos.registrarDisparo(unDisparoEnemigo)
    gestorEnemigos.registrarDisparo(unDisparoEnemigo)
    
    // Solo ocupa 1 lugar
    assert.equals(1, gestorEnemigos.cantidadActivos())

    // Liberamos uno que nunca se registró
    const disparoFantasma = new DisparoMock(bando = enemigo, dano = 1)
    gestorEnemigos.liberarDisparo(disparoFantasma)

    // El gestor ignora el fantasmita y no cambia de tamaño
    assert.equals(1, gestorEnemigos.cantidadActivos())
  }

  test "El gestor del jugador no tiene límite de disparos en pantalla" {
    // Registramos 20 disparos
    20.times({ i => 
      gestorJugador.registrarDisparo(new DisparoMock(bando = jugador, dano = 1)) 
    })

    // El jugador sigue pudiendo disparar
    assert.that(gestorJugador.puedeDisparar())
  }
}