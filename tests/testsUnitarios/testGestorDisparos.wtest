import wollok.game.*
import src.mecanicas.bandos.*
import src.mecanicas.gestores.gestorDisparos.*
import tests.mocks.mocksPersonaje.*

describe "Gestor de disparos enemigos" {

  const unDisparo = new DisparoMock(bando = enemigo, dano = 1)

  method registrarEnemigos(cantidad) {
    cantidad.times({ i => gestorEnemigos.registrarDisparo(new DisparoMock(bando = enemigo, dano = 1)) })
  }

  test "con un lugar libre todavía puede disparar" {
    self.registrarEnemigos(gestorEnemigos.limiteMaximo() - 1)

    assert.that(gestorEnemigos.puedeDisparar())
  }

  test "al llegar a su tope no puede disparar" {
    self.registrarEnemigos(gestorEnemigos.limiteMaximo())

    assert.notThat(gestorEnemigos.puedeDisparar())
  }

  test "al liberar un disparo vuelve a poder disparar" {
    gestorEnemigos.registrarDisparo(unDisparo)
    self.registrarEnemigos(gestorEnemigos.limiteMaximo() - 1)
    assert.notThat(gestorEnemigos.puedeDisparar())

    gestorEnemigos.liberarDisparo(unDisparo)

    assert.that(gestorEnemigos.puedeDisparar())
  }

  test "registrar dos veces el mismo disparo no ocupa dos lugares" {
    gestorEnemigos.registrarDisparo(unDisparo)
    gestorEnemigos.registrarDisparo(unDisparo)

    assert.equals(1, gestorEnemigos.cantidadActivos())
  }

  test "liberar un disparo que no estaba registrado no cambia nada" {
    gestorEnemigos.liberarDisparo(unDisparo)

    assert.equals(0, gestorEnemigos.cantidadActivos())
  }

  test "la dificultad puede ampliar el tope" {
    assert.equals(10, gestorEnemigos.limiteMaximo())
  }

  test "la dificultad puede reducir el tope, redondeando hacia abajo" {
    assert.equals(2, gestorEnemigos.limiteMaximo())
  }
}

describe "Gestor de disparos del jugador" {

  test "no tiene tope: puede disparar aunque haya muchos disparos activos" {
    20.times({ i => gestorJugador.registrarDisparo(new DisparoMock(bando = jugador, dano = 1)) })

    assert.that(gestorJugador.puedeDisparar())
  }
}