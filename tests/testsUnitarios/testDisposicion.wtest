import wollok.game.*
import src.mecanicas.direcciones.*
import src.niveles.disposicion.*
import src.personajes.factory.tiposPersonajes.tiposDeEnemigos.*

describe "Diseño de formaciones (Disposicion y FilaDeEnemigos)" {

  method initialize() {
    game.width(20)
    game.height(20)
  }

  // FilaDeEnemigos

  test "Una fila se centra horizontalmente en el tablero y respeta la separación indicada" {
    // Enemigos contiguos (separación 1)
    const filaContigua = new FilaDeEnemigos(tipos = [pulpo, calamar, alien])
    const celdasContiguas = filaContigua.celdasEn(10)
    
    assert.equals(game.at(8, 10), celdasContiguas.first().last())
    assert.equals(game.at(10, 10), celdasContiguas.last().last())

    // Enemigos separados (separación 2)
    const filaSeparada = new FilaDeEnemigos(tipos = [pulpo, calamar], separacion = 2)
    const celdasSeparadas = filaSeparada.celdasEn(10)

    assert.equals(game.at(8, 10), celdasSeparadas.first().last())
    assert.equals(game.at(10, 10), celdasSeparadas.last().last()) // <-- Acá estaba el error (decía 11)
  }

  test "Cada celda generada contiene el tipo de enemigo en el orden correcto" {
    const tiposEsperados = [pulpo, alien, sepia]
    const unaFila = new FilaDeEnemigos(tipos = tiposEsperados)
    const celdas = unaFila.celdasEn(10)

    // Extrae el primer elemento de cada par [tipo, posicion]
    const tiposObtenidos = celdas.map({ celda => celda.first() })
    assert.equals(tiposEsperados, tiposObtenidos)
  }

  // Ayudas de fila (object fila)

  test "Las ayudas de fila construyen los tipos de enemigos correctamente" {
    // Fila normal y separada
    assert.equals(3, fila.de(pulpo, 3).celdasEn(10).size())
    assert.equals(3, fila.separada(alien, 3).celdasEn(10).size())
    
    // Fila mezclada
    const mezcla = fila.mezcla([pulpo, alien])
    const tiposMezclados = mezcla.celdasEn(10).map({ celda => celda.first() })
    assert.equals([pulpo, alien], tiposMezclados)
  }

  // Disposicion

  test "Una disposición vacía no genera celdas y usa el intervalo por defecto" {
    const disposicion = new Disposicion(filas = [])

    assert.equals(800, disposicion.intervalo())
    assert.that(disposicion.celdas().isEmpty())
  }

  test "Las filas se apilan verticalmente una debajo de la otra partiendo del límite superior" {
    const disposicion = new Disposicion(
      filas = [
        fila.de(pulpo, 1),
        fila.de(calamar, 1)
      ]
    )
    const celdas = disposicion.celdas()
    
    // La primera fila arranca en filaMaxima - 1 (por la lógica del HUD)
    const yEsperada = tablero.filaMaxima() - 1
    
    assert.equals(yEsperada, celdas.first().last().y())
    assert.equals(yEsperada - 1, celdas.last().last().y())
  }

  test "La disposición acumula todas las celdas de todas las filas en orden" {
    const disposicion = new Disposicion(
      filas = [
        fila.de(pulpo, 2),
        fila.de(calamar, 2)
      ]
    )
    const celdas = disposicion.celdas()

    assert.equals(4, celdas.size())
    assert.equals([pulpo, pulpo, calamar, calamar], celdas.map({ celda => celda.first() }))
  }
}