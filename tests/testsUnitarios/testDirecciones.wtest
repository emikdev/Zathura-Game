import wollok.game.*
import src.mecanicas.direcciones.*

describe "Zona jugable del tablero" {

  method initialize() {
    game.width(20)
    game.height(20)
  }

  test "El tablero delimita la zona jugable dejando las filas de arriba y abajo para el HUD" {
    // Esquinas válidas de la zona jugable
    assert.that(tablero.dentro(game.at(0, 1)))
    assert.that(tablero.dentro(game.at(19, 18)))

    // Fuera de límites (HUD y bordes)
    assert.notThat(tablero.dentro(game.at(5, 0)))   // Fila del HUD inferior
    assert.notThat(tablero.dentro(game.at(5, 19)))  // Fila del HUD superior
    assert.notThat(tablero.dentro(game.at(-1, 5)))  // Fuera del tablero a la izquierda
    assert.notThat(tablero.dentro(game.at(20, 5)))  // Fuera del tablero a la derecha
  }
}

describe "Direcciones" {

  method initialize() {
    game.width(20)
    game.height(20)
  }

  test "Cada dirección avanza una celda hacia su lado" {
    assert.equals(game.at(5, 6), arriba.siguiente(game.at(5, 5)))
    assert.equals(game.at(5, 4), abajo.siguiente(game.at(5, 5)))
    assert.equals(game.at(6, 5), derecha.siguiente(game.at(5, 5)))
    assert.equals(game.at(4, 5), izquierda.siguiente(game.at(5, 5)))
  }

  test "Cada dirección conoce su opuesta" {
    assert.equals(abajo, arriba.opuesta())
    assert.equals(arriba, abajo.opuesta())
    assert.equals(izquierda, derecha.opuesta())
    assert.equals(derecha, izquierda.opuesta())
  }

  test "Se puede avanzar hasta los límites permitidos pero no hacia el HUD o fuera del tablero" {
    // Límite superior permitido
    assert.equals(game.at(5, 18), arriba.siguiente(game.at(5, 17)))
    assert.notThat(arriba.puedeAvanzar(game.at(5, 18)))

    // Límite inferior permitido
    assert.equals(game.at(5, 1), abajo.siguiente(game.at(5, 2)))
    assert.notThat(abajo.puedeAvanzar(game.at(5, 1)))

    // Límites laterales permitidos
    assert.equals(game.at(19, 5), derecha.siguiente(game.at(18, 5)))
    assert.notThat(derecha.puedeAvanzar(game.at(19, 5)))
    
    assert.equals(game.at(0, 5), izquierda.siguiente(game.at(1, 5)))
    assert.notThat(izquierda.puedeAvanzar(game.at(0, 5)))
  }

  test "Si se intenta avanzar contra un límite, siguiente devuelve la misma posición" {
    assert.equals(game.at(5, 18), arriba.siguiente(game.at(5, 18)))
    assert.equals(game.at(0, 5), izquierda.siguiente(game.at(0, 5)))
  }

  test "Intentar moverse repetidamente contra un límite no saca al objeto de la zona jugable" {
    var posicion = game.at(19, 18)
    
    5.times({ i =>
      posicion = derecha.siguiente(posicion)
      posicion = arriba.siguiente(posicion)
    })

    assert.equals(game.at(19, 18), posicion)
  }
}