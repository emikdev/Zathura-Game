import wollok.game.*
import src.mecanicas.direcciones.*
import src.personajes.comportamiento.movimiento.travesia.*
import tests.mocks.mocksTravesia.*

describe "Comportamiento de Travesía (Ovnis)" {

  var travesiaDerecha
  var ovni

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    travesiaDerecha = new Travesia(intervalo = 100, direccion = derecha)
    ovni = new OvniMock(position = game.at(5, 10))
  }

  // Movimiento recto

  test "Avanza al personaje en la dirección indicada al acumular el tiempo del intervalo" {
    // Simulamos el paso de 100ms (el intervalo de la travesía)
    travesiaDerecha.tick(ovni, 100)

    assert.equals(game.at(6, 10), ovni.position())
    assert.equals(1, ovni.movimientos())
  }

  test "Mantiene la trayectoria y la fila en los pasos siguientes" {
    travesiaDerecha.tick(ovni, 100)
    travesiaDerecha.tick(ovni, 100)
    travesiaDerecha.tick(ovni, 100)

    assert.equals(game.at(8, 10), ovni.position())
    assert.equals(10, ovni.position().y())
  }

  // Límites del tablero

  test "Al llegar al borde del tablero, detiene al personaje sin moverlo de su última celda" {
    // Lo posicionamos en el borde derecho (última columna jugable)
    ovni.position(game.at(19, 10))
    
    travesiaDerecha.tick(ovni, 100)

    // Se queda en el borde y se le avisa al personaje que se detenga
    assert.equals(game.at(19, 10), ovni.position())
    assert.equals(0, ovni.movimientos())
    assert.equals(1, ovni.detenidos())
  }

  // Detención manual (muerte del ovni)

  test "Si se detiene la travesía manualmente, deja de actualizar al personaje" {
    travesiaDerecha.detener() // Simula que el ovni murió y la travesía se detuvo

    travesiaDerecha.tick(ovni, 100)

    // El tick pasa, pero como la travesía está inactiva, el ovni no se mueve
    assert.equals(0, ovni.movimientos())
  }
}