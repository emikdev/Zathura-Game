import src.muros.animacion.animacionPorImpacto.*
import tests.mocks.mocksMuro.*

describe "Animación por impacto" {

  const estado = new EstadoAnimacionMock()
  const recurso = new RecursoFramesMock(frames = ["a.png", "b.png", "c.png"])
  const animacion = new AnimacionPorImpacto(estado = estado, recursoDeAnimacion = recurso)

  test "arranca en el primer frame" {
    assert.equals("a.png", animacion.frameActual())
  }

  test "puede arrancar en otro frame" {
    const avanzada = new AnimacionPorImpacto(estado = estado, recursoDeAnimacion = recurso, frameActual = 2)

    assert.equals("c.png", avanzada.frameActual())
  }

  test "avanzar pasa al frame siguiente" {
    animacion.avanzar()

    assert.equals("b.png", animacion.frameActual())
  }

  test "avanza un frame por cada pedido" {
    animacion.avanzar()
    animacion.avanzar()

    assert.equals("c.png", animacion.frameActual())
  }

  test "mientras no esté en el último frame no avisa al estado" {
    animacion.avanzar()
    animacion.avanzar()

    assert.equals(0, estado.terminos())
  }

  test "estando en el último frame, avanzar avisa al estado y no cambia de frame" {
    animacion.avanzar()
    animacion.avanzar()

    animacion.avanzar()

    assert.equals(1, estado.terminos())
    assert.equals("c.png", animacion.frameActual())
  }

  test "una animación detenida ignora los pedidos de avanzar" {
    animacion.detener()

    animacion.avanzar()

    assert.equals("a.png", animacion.frameActual())
    assert.equals(0, estado.terminos())
  }
}