import wollok.game.*
import src.mecanicas.formacion.*
import tests.mocks.mocksFormacion.*
import src.gestores.reloj.*

describe "Formación: Movimiento y bordes" {

  var nivel
  var formacion
  var izquierdo
  var derecho

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    reloj.limpiarTodo()
    
    nivel = new NivelMock()
    formacion = new Formacion(nivel = nivel, intervalo = 100)
    izquierdo = new EnemigoMock(position = game.at(5, 10))
    derecho = new EnemigoMock(position = game.at(6, 10))
  }

  test "Mientras todos puedan avanzar, se mueven juntos en bloque" {
    formacion.agregar(izquierdo)
    formacion.agregar(derecho)

    formacion.mover()

    assert.equals(game.at(6, 10), izquierdo.position())
    assert.equals(game.at(7, 10), derecho.position())
  }

  test "Si uno solo choca contra el borde, toda la formación baja y cambia de dirección" {
    // Ponemos a uno en el borde derecho para forzar el choque
    izquierdo.position(game.at(19, 10))
    formacion.agregar(izquierdo)
    formacion.agregar(derecho) // Está en el 6,10

    formacion.mover() // Al chocar, deben bajar y cambiar a izquierda

    assert.equals(game.at(19, 9), izquierdo.position())
    assert.equals(game.at(6, 9), derecho.position())

    formacion.mover() // Ahora se mueven a la izquierda

    assert.equals(game.at(18, 9), izquierdo.position())
    assert.equals(game.at(5, 9), derecho.position())
  }
}

describe "Formación: Ataques" {

  var nivel
  var formacion
  var deAtras
  var deAdelante
  var deOtraColumna

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    reloj.limpiarTodo()
    
    nivel = new NivelMock()
    formacion = new Formacion(nivel = nivel, intervalo = 100)
    deAtras = new EnemigoMock(position = game.at(5, 12))
    deAdelante = new EnemigoMock(position = game.at(5, 10))
    deOtraColumna = new EnemigoMock(position = game.at(7, 11))
    
    formacion.agregar(deAtras)
    formacion.agregar(deAdelante)
    formacion.agregar(deOtraColumna)
  }

  test "En cada columna solo está al frente el enemigo más cercano a la nave" {
    assert.that(formacion.estaAlFrente(deAdelante))
    assert.notThat(formacion.estaAlFrente(deAtras))
    assert.that(formacion.estaAlFrente(deOtraColumna))
  }

  test "Atacar le ordena intentar un ataque solo a la primera línea" {
    formacion.atacar()

    assert.equals(1, deAdelante.ataques())
    assert.equals(1, deOtraColumna.ataques())
    assert.equals(0, deAtras.ataques())
  }

  test "Si el de adelante sale de la formación, el de atrás pasa a primera línea" {
    formacion.quitar(deAdelante)

    assert.that(formacion.estaAlFrente(deAtras))
  }
}

describe "Formación: Ciclo de vida y paso del reloj" {

  var nivel
  var formacion
  var uno
  var dos

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    reloj.limpiarTodo()
    
    nivel = new NivelMock()
    formacion = new Formacion(nivel = nivel, intervalo = 100)
    uno = new EnemigoMock(position = game.at(5, 10))
    dos = new EnemigoMock(position = game.at(6, 10))
    
    formacion.agregar(uno)
    formacion.agregar(dos)
  }

  test "Un paso completo mueve a todos y luego hace atacar a la primera línea" {
    formacion.paso()

    // Verifica que se movieron
    assert.equals(game.at(6, 10), uno.position())
    assert.equals(game.at(7, 10), dos.position())
    
    // Verifica que atacaron
    assert.equals(1, uno.ataques())
    assert.equals(1, dos.ataques())
  }

  test "Al quitar un enemigo, este deja de moverse y atacar con la formación" {
    formacion.quitar(uno)

    formacion.paso()

    // 'uno' se quedó quieto
    assert.equals(game.at(5, 10), uno.position())
    assert.equals(0, uno.ataques())
    
    // 'dos' siguió con la formación
    assert.equals(game.at(7, 10), dos.position())
    assert.equals(1, dos.ataques())
  }

  test "Al quitar al último enemigo, se avisa al nivel que la formación quedó vacía" {
    formacion.quitar(uno)
    assert.equals(0, nivel.avisos()) // Todavía queda 'dos'

    formacion.quitar(dos)
    assert.equals(1, nivel.avisos()) // Se quedó vacía
  }
}