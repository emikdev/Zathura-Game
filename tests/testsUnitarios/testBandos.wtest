import wollok.game.*
import src.mecanicas.bandos.bandoJugador.*
import src.mecanicas.bandos.bandoEnemigo.*
import src.gestores.gestorDisparos.*
import tests.mocks.mocksPersonaje.*

describe "Bandos: delegación de disparos" {

  method initialize() {
    // Limpiamos los gestores para evitar que el estado de un test afecte al otro
    // (Si tus gestores no tienen un método limpiar(), deberías agregarlo, 
    // o inicializar los disparos a 0 de alguna forma).
    gestorJugador.limpiar()
    gestorEnemigos.limpiar()
  }

  test "Cada bando registra y libera sus disparos en su propio gestor" {
    const disparo = new DisparoMock(bando = jugador, dano = 1)
    
    // Al registrar, el disparo entra en el gestor del jugador
    jugador.registrar(disparo)
    assert.equals(1, gestorJugador.cantidadActivos())
    assert.equals(0, gestorEnemigos.cantidadActivos())
    
    // Al liberar, el disparo sale del gestor
    jugador.liberar(disparo)
    assert.equals(0, gestorJugador.cantidadActivos())
  }

  test "El límite de disparos en pantalla aplica solo al bando enemigo" {
    // Llenamos el gestor del enemigo hasta su límite máximo
    gestorEnemigos.limiteMaximo().times({ i => 
      enemigo.registrar(new DisparoMock(bando = enemigo, dano = 1)) 
    })

    // El enemigo llega a su tope y ya no puede disparar
    assert.notThat(enemigo.puedeDisparar())
    
    // Pero el jugador no tiene ese límite y puede seguir disparando
    assert.that(jugador.puedeDisparar())
  }
}