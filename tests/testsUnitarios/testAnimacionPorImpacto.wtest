import src.muros.animacion.animacionPorImpacto.*
import tests.mocks.mocksMuro.*

describe "Animación por impacto (Muros)" {

  var estado
  var recurso
  var animacion

  method initialize() {
    estado = new EstadoAnimacionMock()
    recurso = new RecursoFramesMock(frames = ["a.png", "b.png", "c.png"])
    
    // Asumimos que AnimacionPorImpacto no avanza por tiempo (autoAvance = false)
    // Si tu clase requiere autoAvance en el constructor, agregalo acá.
    animacion = new AnimacionPorImpacto(estado = estado, recursoDeAnimacion = recurso, autoAvance = false)
  }

  test "Arranca en el primer frame por defecto, pero puede empezar en otro" {
    assert.equals("a.png", animacion.frameActual())

    // Usamos el método que creamos en el refactor en lugar de pasarlo por constructor
    animacion.posicionarEnFrame(2)
    assert.equals("c.png", animacion.frameActual())
  }

  test "Cada pedido de avanzar desplaza un frame hacia adelante" {
    animacion.avanzar()
    assert.equals("b.png", animacion.frameActual())

    animacion.avanzar()
    assert.equals("c.png", animacion.frameActual())
  }

  test "Al pedir avanzar en el último frame, avisa al estado y no cambia de frame" {
    // Lo posicionamos directo en el último frame
    animacion.posicionarEnFrame(2) 

    animacion.avanzar()

    assert.equals(1, estado.terminos()) // Avisó al estado
    assert.equals("c.png", animacion.frameActual()) // Se quedó en el último frame
  }

  test "Una animación detenida ignora los pedidos de avanzar" {
    animacion.detener()

    animacion.avanzar()

    assert.equals("a.png", animacion.frameActual())
    assert.equals(0, estado.terminos())
  }
}