import src.mecanicas.armas.armasDeNave.*
import tests.mocks.mocksArsenal.*
import src.mecanicas.arsenal.*


describe "tests de arsenal" {

    const armaBasica = new ArmaMock(municion = 1000)
    const armaEspecial1 = new ArmaMock(municion = 1)
    const armaEspecial2 = new ArmaMock(municion = 5)

    const arsenalTest = new Arsenal(armas = [armaBasica, armaEspecial1])

    test "Lista de armas empieza en arma basica"{
        assert.equals(armaBasica, arsenalTest.armaActual())
    }

    test "Uso de equipar siguiente arma"{

        assert.equals(armaBasica, arsenalTest.armaActual())
        arsenalTest.equiparSiguienteArma()
        assert.equals(armaEspecial1, arsenalTest.armaActual())
        arsenalTest.equiparSiguienteArma()
        assert.equals(armaBasica, arsenalTest.armaActual())
        
    }

    test "Agrega armaEspecial2 a armas"{

        arsenalTest.agregarAArmas(armaEspecial2)
        arsenalTest.equiparSiguienteArma()
        arsenalTest.equiparSiguienteArma()

        assert.equals(armaEspecial2, arsenalTest.armaActual())
        

    }

    test "Descarte de arma sin municion"{
        arsenalTest.equiparSiguienteArma()

        arsenalTest.verificarArmaActual()
        assert.equals(armaEspecial1, arsenalTest.armaActual())
        
        arsenalTest.armaActual().disparar()
        arsenalTest.verificarArmaActual()

        assert.equals(armaBasica, arsenalTest.armaActual())

    }

    test "Dispara arma basica y se verifica que no se descarte"{

        arsenalTest.armaActual().disparar()
        arsenalTest.verificarArmaActual()

        assert.equals(armaBasica, arsenalTest.armaActual())

    }

    

}