import wollok.game.*
import src.gestores.gestorDePuntos.*
import src.personajes.factory.factory.*
import src.personajes.factory.tiposPersonajes.tiposDeEnemigos.*
import src.personajes.factory.tiposPersonajes.tiposDeOvnis.*
import tests.mocks.mocksPuntosPorEnemigo.*

describe "Tests de puntos otorgados por los enemigos" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    gestorPuntaje.reiniciar()
  }

  // Suma de puntos al morir

  test "Al morir, un enemigo suma los puntos configurados en su tipo" {
    const enemigoNormal = factory.crearEnemigo(alien, formacionMock, game.at(1, 10))
    enemigoNormal.alQuedarseSinVidas()
    assert.equals(alien.puntosQueOtorga(), gestorPuntaje.puntos())

    const enemigoEspecial = factory.crearEnemigo(alienHeavy, formacionMock, game.at(2, 10))
    enemigoEspecial.alQuedarseSinVidas()
    
    // Comprobamos que los puntos se acumulan (los del normal + los del especial)
    assert.equals(alien.puntosQueOtorga() + alienHeavy.puntosQueOtorga(), gestorPuntaje.puntos())
  }

  test "Al morir, un ovni suma los puntos configurados en su tipo" {
    const ovni = factory.crearOvni(ovniBasico, game.at(3, 10), null)
    
    ovni.alQuedarseSinVidas()

    assert.equals(ovniBasico.puntosQueOtorga(), gestorPuntaje.puntos())
  }

  test "Matar varios enemigos acumula los puntos de todos en el marcador" {
    const enemigoNormal = factory.crearEnemigo(alien, formacionMock, game.at(1, 10))
    const enemigoHeavy = factory.crearEnemigo(alienHeavy, formacionMock, game.at(2, 10))
    const ovni = factory.crearOvni(ovniBasico, game.at(3, 10), null)

    enemigoNormal.alQuedarseSinVidas()
    enemigoHeavy.alQuedarseSinVidas()
    ovni.alQuedarseSinVidas()

    const totalEsperado = alien.puntosQueOtorga() + alienHeavy.puntosQueOtorga() + ovniBasico.puntosQueOtorga()
    assert.equals(totalEsperado, gestorPuntaje.puntos())
  }
}