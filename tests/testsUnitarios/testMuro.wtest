import wollok.game.*
import src.muros.muros.*
import src.mecanicas.bandos.*
import src.mecanicas.gestores.gestorDeMuros.*
import tests.mocks.mocksMuro.*
import tests.mocks.mocksPersonaje.*

describe "Muro: en pie" {

  const muro = fabricaDeMuros.muro()

  method initialize() {
    game.width(20)
    game.height(20)
  }

  test "nace entero, mostrando el primer frame" {
    assert.equals("muro0.png", muro.image())
  }

  test "pertenece al bando neutral" {
    assert.equals(neutral, muro.bando())
  }

  test "cada impacto avanza un frame hacia más destruido" {
    muro.recibirImpacto()
    assert.equals("muro1.png", muro.image())

    muro.recibirImpacto()
    assert.equals("muro2.png", muro.image())
  }

  test "con tantos impactos como frames menos uno queda en el último frame, todavía en pie" {
    3.times({ i => muro.recibirImpacto() })

    assert.equals("muro3.png", muro.image())
  }

  test "el impacto siguiente al último frame lo empieza a destruir" {
    4.times({ i => muro.recibirImpacto() })

    assert.equals("muerte0.png", muro.image())
  }

  test "morir lo destruye sin pasar por los frames intermedios" {
    muro.morir()

    assert.equals("muerte0.png", muro.image())
  }

  test "con impactos iniciales arranca más destruido" {
    const muroDañado = fabricaDeMuros.muroConImpactos(2)

    assert.equals("muro2.png", muroDañado.image())
  }

  test "los impactos iniciales se limitan: nunca nace ya destruido, queda a un impacto de caer" {
    const muroAlLimite = fabricaDeMuros.muroConImpactos(10)
    assert.equals("muro3.png", muroAlLimite.image())

    muroAlLimite.recibirImpacto()

    assert.equals("muerte0.png", muroAlLimite.image())
  }

  test "al iniciarse queda en el tablero" {
    muro.iniciar()
    assert.that(game.hasVisual(muro))
  }

  test "al retirarse sale del tablero" {
    muro.iniciar()
    muro.retirar()
    assert.notThat(game.hasVisual(muro))
  }

  test "retirar un muro que no está en el tablero no falla" {
    assert.doesNotThrowException({ muro.retirar() })
  }
}

describe "Muro: destruyéndose" {

  const muro = fabricaDeMuros.muro()

  method initialize() {
    game.width(20)
    game.height(20)
    muro.morir()
  }

  test "muestra su animación de muerte" {
    assert.equals("muerte0.png", muro.image())
  }

  test "ignora nuevos impactos" {
    3.times({ i => muro.recibirImpacto() })

    assert.equals("muerte0.png", muro.image())
  }

  test "ignora una segunda muerte y no reinicia su animación" {
    muro.morir()
    assert.equals("muerte0.png", muro.image())
  }

  test "al terminar su animación de muerte sale del tablero" {
    muro.iniciar()
    muro.estado().terminoAnimacion()
    assert.notThat(game.hasVisual(muro))
  }
}

describe "Muro: colisión con disparos" {

  const muro = fabricaDeMuros.muro()
  const disparoJugador = new DisparoMock(bando = jugador, dano = 1)
  const disparoEnemigo = new DisparoMock(bando = enemigo, dano = 1)
  const disparoPotente = new DisparoMock(bando = jugador, dano = 100)

  method initialize() {
    game.width(20)
    game.height(20)
  }

  test "un disparo del jugador lo daña y se destruye" {
    muro.colisionaCon(disparoJugador)

    assert.equals("muro1.png", muro.image())
    assert.that(disparoJugador.fueDestruido())
  }

  test "un disparo enemigo también lo daña y se destruye" {
    muro.colisionaCon(disparoEnemigo)

    assert.equals("muro1.png", muro.image())
    assert.that(disparoEnemigo.fueDestruido())
  }

  test "el daño del disparo no importa: cada impacto avanza un solo frame" {
    muro.colisionaCon(disparoPotente)

    assert.equals("muro1.png", muro.image())
  }

  test "los disparos de ambos bandos se acumulan hasta destruirlo" {
    muro.colisionaCon(disparoJugador)
    muro.colisionaCon(disparoEnemigo)
    muro.colisionaCon(disparoJugador)
    assert.equals("muro3.png", muro.image())

    muro.colisionaCon(disparoEnemigo)

    assert.equals("muerte0.png", muro.image())
  }

  test "un muro que se está destruyendo es atravesado por los disparos, sin sumar impactos" {
    muro.morir()

    muro.colisionaCon(disparoJugador)

    assert.equals("muerte0.png", muro.image())
    assert.notThat(disparoJugador.fueDestruido())
  }
}

describe "Muro: colisión con objetos" {

  const muro = fabricaDeMuros.muro()
  const objeto = new ObjetoMock()

  method initialize() {
    game.width(20)
    game.height(20)
  }

  test "al chocar con un objeto mueren el muro y el objeto" {
    muro.colisionaConObjeto(objeto)

    assert.equals("muerte0.png", muro.image())
    assert.equals(1, objeto.muertes())
  }

  test "el muro muere de una, sin pasar por los frames intermedios" {
    muro.recibirImpacto()

    muro.colisionaConObjeto(objeto)

    assert.equals("muerte0.png", muro.image())
  }

  test "si el muro ya se está destruyendo, el objeto igual muere" {
    muro.morir()

    muro.colisionaConObjeto(objeto)

    assert.equals(1, objeto.muertes())
    assert.equals("muerte0.png", muro.image())
  }
}