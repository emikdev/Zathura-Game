import wollok.game.*
import src.muros.muro.*
import src.mecanicas.bandos.bandoJugador.*
import src.mecanicas.bandos.bandoEnemigo.*
import tests.mocks.mocksMuro.*
import tests.mocks.mocksPersonaje.*
import src.gestores.reloj.*

describe "Muro: En pie y ciclo de vida" {

  var muro

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    reloj.limpiarTodo() // Evita que queden animaciones colgadas entre tests
    muro = fabricaDeMuros.muro()
  }

  test "Nace entero mostrando el primer frame" {
    assert.equals("muro0.png", muro.image())
  }

  test "Cada impacto avanza un frame, hasta llegar al límite antes de destruirse" {
    muro.recibirImpacto()
    assert.equals("muro1.png", muro.image())

    muro.recibirImpacto()
    assert.equals("muro2.png", muro.image())

    muro.recibirImpacto()
    assert.equals("muro3.png", muro.image()) // Último frame en pie

    muro.recibirImpacto()
    assert.equals("muerte0.png", muro.image()) // Pasa a destruyéndose
  }

  test "Morir lo pasa al estado Destruyéndose sin pasar por los frames intermedios" {
    muro.morir()
    assert.equals("muerte0.png", muro.image())
  }

  test "Los impactos iniciales se limitan: nunca nace destruido" {
    const muroAlLimite = fabricaDeMuros.muroConImpactos(10)
    assert.equals("muro3.png", muroAlLimite.image())

    muroAlLimite.recibirImpacto()
    assert.equals("muerte0.png", muroAlLimite.image())
  }

  test "Iniciar lo agrega al tablero y retirar lo saca (incluso si no estaba)" {
    muro.iniciar()
    assert.that(game.hasVisual(muro))
    
    muro.retirar()
    assert.notThat(game.hasVisual(muro))
    
    muro.retirar() // Retirar de nuevo no debe fallar
    assert.notThat(game.hasVisual(muro))
  }
}

describe "Muro: Destrucción" {

  var muro

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    reloj.limpiarTodo()
    muro = fabricaDeMuros.muro()
    muro.morir() // Lo pasamos al estado Destruyéndose
  }

  test "Muestra su animación de muerte e ignora nuevos impactos" {
    assert.equals("muerte0.png", muro.image())
    
    3.times({ i => muro.recibirImpacto() })
    assert.equals("muerte0.png", muro.image()) // Sigue igual
  }

  test "Al terminar su animación de muerte sale del tablero" {
    muro.iniciar()
    muro.estado().terminoAnimacion() // Simulamos que la animación terminó
    
    assert.notThat(game.hasVisual(muro))
  }
}

describe "Muro: Colisiones" {

  var muro
  var disparoJugador
  var disparoEnemigo
  var disparoPotente

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    reloj.limpiarTodo()
    
    muro = fabricaDeMuros.muro()
    disparoJugador = new DisparoMock(bando = jugador, dano = 1)
    disparoEnemigo = new DisparoMock(bando = enemigo, dano = 1)
    disparoPotente = new DisparoMock(bando = jugador, dano = 100)
  }

  test "Los disparos de cualquier bando lo dañan y se destruyen" {
    muro.colisionaCon(disparoJugador)
    assert.equals("muro1.png", muro.image())
    assert.that(disparoJugador.fueDestruido())

    muro.colisionaCon(disparoEnemigo)
    assert.equals("muro2.png", muro.image())
    assert.that(disparoEnemigo.fueDestruido())
  }

  test "El daño del disparo es irrelevante: cada impacto avanza un solo frame" {
    muro.colisionaCon(disparoPotente)
    assert.equals("muro1.png", muro.image())
  }

  test "Los disparos de ambos bandos se acumulan hasta destruirlo" {
    muro.colisionaCon(disparoJugador)
    muro.colisionaCon(disparoEnemigo)
    muro.colisionaCon(disparoJugador)
    assert.equals("muro3.png", muro.image())

    muro.colisionaCon(disparoEnemigo)
    assert.equals("muerte0.png", muro.image())
  }

  test "Un muro que se está destruyendo es atravesado por los disparos" {
    muro.morir()
    muro.colisionaCon(disparoJugador)
    
    assert.equals("muerte0.png", muro.image())
    assert.notThat(disparoJugador.fueDestruido()) // El disparo no choca
  }

  test "Al chocar con un objeto, el muro y el objeto mueren de inmediato" {
    const objeto = new ObjetoMock()
    muro.recibirImpacto() // Le damos un impacto previo para confirmar que no pasa por frames

    muro.colisionaConObjeto(objeto)

    assert.equals("muerte0.png", muro.image())
    assert.equals(1, objeto.muertes())
  }
}