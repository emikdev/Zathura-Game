import wollok.game.*
import src.mecanicas.hud.visualsHud.*
import tests.mocks.mocksHud.*

describe "Visuales del HUD" {

  var nave
  var visualVida
  var visualArma
  var centena
  var decena
  var unidad

  method initialize() {
    nave = new NaveMock()
    visualVida = new VisualVida(nave = nave, posicion = game.at(4, 0))
    visualArma = new VisualArma(nave = nave, posicion = game.at(1, 0))
    centena = new Centena(nave = nave, posicion = game.at(2, 0))
    decena = new Decena(nave = nave, posicion = game.at(3, 0))
    unidad = new Unidad(nave = nave, posicion = game.at(4, 0))
  }

  // Visual de vida

  test "El visual de vida refleja el estado actual de la nave" {
    nave.vidas(3)
    assert.equals("vida-frame3.png", visualVida.image())

    nave.vidas(2)
    assert.equals("vida-frame2.png", visualVida.image())
  }

  test "Si la nave se queda sin vidas, el visual muestra el frame de cero" {
    nave.vidas(0)
    assert.equals("vida-frame0.png", visualVida.image())
  }

  // Visual de arma

  test "El visual de arma refleja el ícono actual y se actualiza al cambiarlo" {
    nave.iconoArmaActual("laser.png")
    assert.equals("laser.png", visualArma.image())

    nave.iconoArmaActual("plasma.png")
    assert.equals("plasma.png", visualArma.image())
  }

  // Visuales de munición

  test "La munición se divide correctamente en centena, decena y unidad" {
    // Un solo test es suficiente para validar que la UI de munición funciona
    nave.municionActual(128)
    
    assert.equals("numero_1.png", centena.image())
    assert.equals("numero_2.png", decena.image())
    assert.equals("numero_8.png", unidad.image())
  }

  test "Los visuales de munición se actualizan dinámicamente al gastar balas" {
    nave.municionActual(10)
    assert.equals("numero_0.png", centena.image())
    assert.equals("numero_1.png", decena.image())
    assert.equals("numero_0.png", unidad.image())

    nave.municionActual(9)
    assert.equals("numero_0.png", centena.image())
    assert.equals("numero_0.png", decena.image())
    assert.equals("numero_9.png", unidad.image())
  }
}