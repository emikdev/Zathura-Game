import wollok.game.*
import src.gestores.gestorNiveles.*
import src.niveles.niveles.*
import src.gestores.gestorMuros.*
import src.gestores.reloj.*

describe "Gestor de niveles: Progresión y fin de partida" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    reloj.limpiarTodo()
    gestorMuros.detener()
    gestorNiveles.reiniciar()
  }

  test "Al iniciar una partida, arranca en el nivel 1 y el contador lo refleja" {
    assert.equals(nivelUno, gestorNiveles.nivelActual())
    assert.equals(1, gestorNiveles.contadorDeNiveles())
  }

  test "Al terminar un nivel, avanza al siguiente y actualiza el contador" {
    assert.that(gestorNiveles.haySiguienteNivel())
    
    gestorNiveles.terminarNivel()
    
    assert.equals(nivelDos, gestorNiveles.nivelActual())
    assert.equals(2, gestorNiveles.contadorDeNiveles())
  }

  test "Al superar el último nivel, se muestra la pantalla de victoria y se reinician los contadores" {
    // Avanzamos hasta el último nivel
    gestorNiveles.terminarNivel()
    gestorNiveles.terminarNivel()
    gestorNiveles.terminarNivel()
    assert.notThat(gestorNiveles.haySiguienteNivel())

    // Terminamos el último nivel (dispara ganar())
    gestorNiveles.terminarNivel()

    assert.that(game.allVisuals().any({ v => v.image() == "ganaste.png" }))
    assert.equals(1, gestorNiveles.contadorDeNiveles()) // Se reinició
    assert.equals(nivelUno, gestorNiveles.nivelActual())
  }

  test "Al perder todas las vidas (gameOver), se muestra la pantalla de derrota y se reinician los contadores" {
    // Simulamos que estaba jugando el nivel 3
    gestorNiveles.terminarNivel()
    gestorNiveles.terminarNivel()

    gestorNiveles.gameOver()

    assert.that(game.allVisuals().any({ v => v.image() == "perdiste.png" }))
    assert.equals(1, gestorNiveles.contadorDeNiveles()) // Se reinició
    assert.equals(nivelUno, gestorNiveles.nivelActual())
  }
}

describe "Gestor de niveles: Interfaz en pantalla" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    reloj.limpiarTodo()
    gestorMuros.detener()
    gestorNiveles.reiniciar()
  }

  test "Mostrar dibuja el cartel de nivel y el contador en el tablero" {
    gestorNiveles.mostrar()
    
    assert.that(game.hasVisual(contador))
    assert.that(game.allVisuals().any({ v => v.image() == "lvl.png" }))
  }

  test "Iniciar el nivel actual carga los elementos del nivel (muros y enemigos) en el tablero" {
    gestorNiveles.iniciarNivelActual()
    
    // Verifica que el nivel haya poblado el tablero
    assert.that(game.allVisuals().size() > 0)
  }
}