import wollok.game.*
import src.gestores.gestorMuros.*

describe "Gestor de muros" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    gestorMuros.detener()
  }

  test "Iniciar crea los muros y los agrega al tablero" {
    gestorMuros.iniciar(1)

    assert.that(gestorMuros.cantidadActivos() > 0)
    assert.equals(gestorMuros.cantidadActivos(), game.allVisuals().size())
  }

  test "Iniciar dos veces no duplica los muros (limpia los anteriores)" {
    gestorMuros.iniciar(1)
    const cantidadInicial = gestorMuros.cantidadActivos()

    gestorMuros.iniciar(1)

    assert.equals(cantidadInicial, gestorMuros.cantidadActivos())
    assert.equals(cantidadInicial, game.allVisuals().size())
  }

  test "Al destruir un muro, sale del gestor y del tablero, pero los demás quedan" {
    gestorMuros.iniciar(1)
    const cantidadInicial = gestorMuros.cantidadActivos()
    const muro = game.allVisuals().first()

    gestorMuros.muroDestruido(muro)

    assert.equals(cantidadInicial - 1, gestorMuros.cantidadActivos())
    assert.equals(cantidadInicial - 1, game.allVisuals().size())
    assert.notThat(game.hasVisual(muro))
  }

  test "Detener retira todos los muros del tablero (incluso si se llama sin muros)" {
    gestorMuros.iniciar(1)
    gestorMuros.detener()
    assert.equals(0, gestorMuros.cantidadActivos())
    assert.that(game.allVisuals().isEmpty())

    // Llamar a detener de nuevo no debe romper nada
    gestorMuros.detener()
    assert.equals(0, gestorMuros.cantidadActivos())
  }

  test "Una dificultad más alta hace nacer los muros más destruidos" {
    // En dificultad 1, nacen enteros
    gestorMuros.iniciar(1)
    const imagenFacil = game.allVisuals().first().image()
    
    // En dificultad 4, nacen más destruidos
    gestorMuros.iniciar(4)
    const imagenDificil = game.allVisuals().first().image()

    assert.notEquals(imagenFacil, imagenDificil)
  }
}