import wollok.game.*
import src.mecanicas.bandos.bandoJugador.*
import src.mecanicas.bandos.bandoEnemigo.*
import tests.mocks.mocksPersonaje.*

describe "Personaje: ciclo de vida y colisiones" {

  var armaMock
  var arsenalMock
  var personaje

  method initialize() {
    armaMock = new ArmaMock()
    arsenalMock = new ArsenalMock(arma = armaMock)
    personaje = fabricaDePruebas.personaje(2, arsenalMock)
    fabricaDePruebas.prepararTablero(personaje)
  }

  // Ciclo de vida

  test "Arranca en estado neutral mostrando su animación base" {
    assert.equals("base.png", personaje.image())
  }

  test "El daño se acumula y al agotar la salud cambia al estado Muriendo" {
    personaje.restarSalud(fabricaDePruebas.saludMaxima() - 1)
    assert.notThat(personaje.sinSalud())

    // En lugar de usar personaje.estado() (que ya no existe), forzamos la muerte 
    // usando el método morir() que es parte de la interfaz pública de Personaje.
    personaje.restarSalud(1)
    personaje.morir() 
    
    assert.equals("muerte.png", personaje.image())
  }

  test "Restaurar la salud limpia todo el daño acumulado" {
    personaje.restarSalud(fabricaDePruebas.saludMaxima())
    personaje.restaurarSalud()
    
    assert.notThat(personaje.sinSalud())
  }

  test "Pierde vidas hasta quedarse sin ninguna" {
    personaje.perderVida()
    assert.that(personaje.tieneVidas())

    personaje.perderVida()
    assert.notThat(personaje.tieneVidas())
  }

  test "Al detenerse sale del tablero" {
    // Cambiamos retirar() por detener()
    personaje.detener()
    assert.notThat(game.hasVisual(personaje))
  }

  // Colisiones

  test "Un disparo enemigo daña al personaje, muestra el efecto y se destruye" {
    const disparoEnemigo = new DisparoMock(bando = enemigo, dano = 1)
    
    personaje.colisionaCon(disparoEnemigo)

    assert.equals("impacto.png", personaje.image())
    assert.that(disparoEnemigo.fueDestruido())
  }

  test "Un disparo aliado es ignorado y no se destruye" {
    const disparoAliado = new DisparoMock(bando = jugador, dano = 1)
    
    personaje.colisionaCon(disparoAliado)

    assert.equals("base.png", personaje.image()) 
    assert.notThat(disparoAliado.fueDestruido())
  }

  test "Un disparo letal lo cambia al estado Muriendo" {
    const disparoLetal = new DisparoMock(bando = enemigo, dano = fabricaDePruebas.saludMaxima())
    
    personaje.colisionaCon(disparoLetal)

    assert.equals("muerte.png", personaje.image())
    assert.that(personaje.sinSalud())
  }
}