import wollok.game.*
import src.mecanicas.disparo.*
import src.mecanicas.bandos.bandoJugador.*
import src.mecanicas.bandos.bandoEnemigo.*
import src.gestores.gestorDisparos.*
import src.gestores.reloj.*
import tests.mocks.mocksPersonaje.*

describe "Disparo: Movimiento y destrucción" {

  var recurso
  var disparoJugador
  var disparoEnemigo

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    reloj.limpiarTodo()
    
    // Limpiamos los gestores para arrancar de cero
    gestorJugador.limpiar()
    gestorEnemigos.limpiar()

    recurso = new RecursoMock(frame = "bala.png")
    disparoJugador = new Disparo(recursoAnimacion = recurso, dano = 1, bando = jugador, position = game.at(5, 5))
    disparoEnemigo = new Disparo(recursoAnimacion = recurso, dano = 1, bando = enemigo, position = game.at(5, 5))
  }

  test "Cada disparo avanza en la dirección que le dicta su bando" {
    disparoJugador.avanzar()
    assert.equals(game.at(5, 6), disparoJugador.position())

    disparoEnemigo.avanzar()
    assert.equals(game.at(5, 4), disparoEnemigo.position())
  }

  test "Al llegar al borde del tablero, el disparo se destruye y sale de la pantalla" {
    const disparoTecho = new Disparo(recursoAnimacion = recurso, dano = 1, bando = jugador, position = game.at(5, 18))
    game.addVisual(disparoTecho)

    disparoTecho.avanzar() 

    assert.notThat(game.hasVisual(disparoTecho))
  }

  test "Al destruirse, sale del tablero y libera su lugar en el gestor del bando" {
    // Registramos directo en el gestor para probar la destrucción
    gestorJugador.registrarDisparo(disparoJugador)
    game.addVisual(disparoJugador)
    
    assert.that(game.hasVisual(disparoJugador))
    assert.equals(1, gestorJugador.cantidadActivos())

    disparoJugador.destruir()

    assert.notThat(game.hasVisual(disparoJugador))
    assert.equals(0, gestorJugador.cantidadActivos())
  }

  test "Al destruirse un disparo enemigo, libera el cupo y permite volver a disparar" {
    // 1. Registramos el disparo REAL en el gestor
    gestorEnemigos.registrarDisparo(disparoEnemigo)
    
    // 2. Llenamos el resto del gestor hasta su límite con Mocks
    (gestorEnemigos.limiteMaximo() - 1).times({ i => 
      gestorEnemigos.registrarDisparo(new DisparoMock(bando = enemigo, dano = 1)) 
    })
    assert.notThat(gestorEnemigos.puedeDisparar())

    // 3. Destruimos el disparo real. Como estaba en la lista, se libera el cupo.
    disparoEnemigo.destruir()

    assert.that(gestorEnemigos.puedeDisparar())
  }
}