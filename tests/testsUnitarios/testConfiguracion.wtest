import wollok.game.*
import src.menu.menu.*
import src.menu.configuracion.*
import src.mecanicas.bandos.*
import src.personajes.factory.tiposPersonajes.tiposDeNaves.*

describe "Dificultad elegida desde el menú y chequeo de el objeto configuracion reciba los valores correctos" {

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    configuracion.dificultadElegida(0)
    configuracion.cantidadJugadores(0)
  }


  method seleccionadorActual() =
    game.allVisuals().find({ visual => visual.className().endsWith("Seleccionador") })

  // Mueve la flecha 'posicion' lugares a la derecha (0 = la primera opción) y aprieta espacio
  method elegir(posicion) {
    const seleccionador = self.seleccionadorActual()
    posicion.times({ i => seleccionador.siguiente() })
    seleccionador.selecciona()
  }

  method simular(jugadores, dificultad) {
    menu.menuCantidadJugadores()
    self.elegir(jugadores - 1)
    jugadores.times({ i => self.elegir(0) })
    self.elegir(dificultad)
  }

  test "1 jugador + easy: dificultad() devuelve 1" {
    self.simular(1, 0)

    assert.equals(1, configuracion.dificultad())
  }

  test "1 jugador + hard: dificultad() devuelve 3" {
    self.simular(1, 2)

    assert.equals(3, configuracion.dificultad())
  }

  test "2 jugadores + easy: dificultad() devuelve 2" {
    self.simular(2, 0)

    assert.equals(2, configuracion.dificultad())
  }

  test "2 jugadores + hard: dificultad() devuelve 4" {
    self.simular(2, 2)

    assert.equals(4, configuracion.dificultad())
  }
}
