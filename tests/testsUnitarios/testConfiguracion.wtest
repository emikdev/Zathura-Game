import src.menu.configuracion.*

describe "Configuración del juego" {

  method initialize() {
    configuracion.cantidadJugadores(1)
    configuracion.dificultadElegida(1)
  }

  test "La cantidad de jugadores aumenta la dificultad efectiva del juego" {
    // 1 Jugador, dificultad Hard (3)
    configuracion.cantidadJugadores(1)
    configuracion.dificultadElegida(3)
    assert.equals(3, configuracion.dificultad())

    // 2 Jugadores, misma dificultad Hard (3). La dificultad efectiva sube a 4.
    configuracion.cantidadJugadores(2)
    configuracion.dificultadElegida(3)
    assert.equals(4, configuracion.dificultad())
  }

  test "El modo fácil con 1 jugador es la experiencia base" {
    configuracion.cantidadJugadores(1)
    configuracion.dificultadElegida(1) 
    
    assert.equals(1, configuracion.dificultad())
  }
}