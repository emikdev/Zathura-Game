import wollok.game.*
import src.mecanicas.hud.hudJugador.*
import tests.mocks.mocksHud.*

describe "HUD del juego" {

  var naveUno
  var naveDos

  method initialize() {
    game.clear()
    game.width(20)
    game.height(20)
    naveUno = new NaveMock(vidas = 3, iconoArmaActual = "laser.png", municionActual = 42)
    naveDos = new NaveMock(vidas = 1)
  }

  // HUD de una sola nave

  test "Al iniciar con una nave crea los 5 visuales correspondientes" {
    hud.iniciar([naveUno])
    
    assert.equals(5, game.allVisuals().size())
  }

  test "Los visuales muestran los datos actuales de la nave en orden" {
    hud.iniciar([naveUno])
    
    const imagenes = game.allVisuals().map({ visual => visual.image() })
    
    // Verificamos que existan los visuales esperados (vida, arma, y las cifras de munición)
    assert.that(imagenes.contains("vida-frame3.png"))
    assert.that(imagenes.contains("laser.png"))
    assert.that(imagenes.contains("numero_0.png")) // Centena
    assert.that(imagenes.contains("numero_4.png")) // Decena
    assert.that(imagenes.contains("numero_2.png")) // Unidad
  }

  test "El HUD se actualiza automáticamente cuando cambia el estado de la nave" {
    hud.iniciar([naveUno])
    
    naveUno.vidas(2)
    naveUno.iconoArmaActual("plasma.png")
    naveUno.municionActual(105)

    const imagenes = game.allVisuals().map({ visual => visual.image() })
    assert.that(imagenes.contains("vida-frame2.png"))
    assert.that(imagenes.contains("plasma.png"))
    assert.that(imagenes.contains("numero_1.png"))
    assert.that(imagenes.contains("numero_0.png"))
    assert.that(imagenes.contains("numero_5.png"))
  }

  // HUD de dos naves

  test "Al iniciar con dos naves crea 10 visuales (5 por nave)" {
    hud.iniciar([naveUno, naveDos])

    assert.equals(10, game.allVisuals().size())
  }

  test "Cada nave tiene su propio indicador de vidas independiente" {
    hud.iniciar([naveUno, naveDos])

    const vidasMostradas = game.allVisuals()
      .map({ visual => visual.image() })
      .filter({ imagen => imagen.startsWith("vida-frame") })

    assert.equals(2, vidasMostradas.size())
    assert.that(vidasMostradas.contains("vida-frame3.png")) // Vidas de naveUno
    assert.that(vidasMostradas.contains("vida-frame1.png")) // Vidas de naveDos
  }

  test "Los HUDs no se superponen y quedan dentro del tablero" {
    hud.iniciar([naveUno, naveDos])

    const posiciones = game.allVisuals().map({ visual => visual.position() })
    
    // Verifica que no haya dos visuales en la misma posición
    assert.equals(posiciones.size(), posiciones.asSet().size())
    
    // Verifica que todos estén dentro de los límites del tablero
    assert.that(game.allVisuals().all({ visual => 
      visual.position().x().between(0, game.width() - 1) && 
      visual.position().y().between(0, game.height() - 1) 
    }))
  }
}