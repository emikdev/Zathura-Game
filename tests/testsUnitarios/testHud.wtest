import wollok.game.*
import src.mecanicas.hud.hudJugador.*
import tests.mocks.mocksHud.*

describe "HUD: una nave" {

  const nave = new NaveMock(vidas = 3, iconoArmaActual = "laser.png", municionActual = 42)

  method initialize() {
    game.width(20)
    game.height(20)
    hud.iniciar([nave])
  }

  // Assets que se ven en las primeras cinco celdas de la fila inferior, de izquierda a derecha
  method imagenesDelHud() = [0, 1, 2, 3, 4].map({ x => game.getObjectsIn(game.at(x, 0)).first().image() })

  test "crea cinco visuales por nave: vidas, arma y tres cifras de munición" {
    assert.equals(5, game.allVisuals().size())
  }

  test "ocupan cinco celdas consecutivas de la esquina inferior izquierda, una cada una" {
    const visualesPorCelda = [0, 1, 2, 3, 4].map({ x => game.getObjectsIn(game.at(x, 0)).size() })
    assert.equals([1, 1, 1, 1, 1], visualesPorCelda)
  }

  test "se ordenan: vidas, arma, centena, decena y unidad" {
    assert.equals(
      ["vida-frame3.png", "laser.png", "numero_0.png", "numero_4.png", "numero_2.png"],
      self.imagenesDelHud()
    )
  }

  test "se actualizan solos cuando cambia el estado de la nave" {
    nave.vidas(2)
    nave.iconoArmaActual("plasma.png")
    nave.municionActual(105)

    assert.equals(
      ["vida-frame2.png", "plasma.png", "numero_1.png", "numero_0.png", "numero_5.png"],
      self.imagenesDelHud()
    )
  }
}

describe "HUD: dos naves" {

  const naveUno = new NaveMock(vidas = 3)
  const naveDos = new NaveMock(vidas = 1)

  method initialize() {
    game.width(20)
    game.height(20)
  }

  method imagenesDeVida() {
    return game.allVisuals()
      .map({ visual => visual.image() })
      .filter({ imagen => imagen.startsWith("vida-frame") })
  }

  test "crea diez visuales, cinco por nave" {
    hud.iniciar([naveUno, naveDos])

    assert.equals(10, game.allVisuals().size())
  }

  test "cada nave tiene su propio visual de vidas" {
    hud.iniciar([naveUno, naveDos])

    assert.equals(2, self.imagenesDeVida().size())
    assert.that(self.imagenesDeVida().contains("vida-frame3.png"))
    assert.that(self.imagenesDeVida().contains("vida-frame1.png"))
  }

  test "el HUD de la primera nave queda a la izquierda y el de la segunda no lo pisa" {
    hud.iniciar([naveUno, naveDos])

    const posiciones = game.allVisuals().map({ visual => visual.position() })
    assert.equals(posiciones.size(), posiciones.asSet().size())
  }

  test "todos los visuales quedan dentro del tablero" {
    hud.iniciar([naveUno, naveDos])

    assert.that(game.allVisuals().all({ visual => visual.position().x().between(0, game.width() - 1) }))
  }

  test "con otro ancho de tablero el HUD de la segunda nave sigue dentro" {
    game.width(30)

    hud.iniciar([naveUno, naveDos])

    assert.that(game.allVisuals().all({ visual => visual.position().x().between(0, game.width() - 1) }))
  }

  test "una nave sola no crea el HUD de la segunda" {
    hud.iniciar([naveUno])

    assert.equals(5, game.allVisuals().size())
  }
}