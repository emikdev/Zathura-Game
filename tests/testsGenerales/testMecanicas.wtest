import wollok.game.*
import src.mecanicas.disparo.*
import src.mecanicas.animador.*
import src.mecanicas.bandos.*
import src.mecanicas.gestorDisparos.*
import src.mecanicas.hud.*

// Bloque de inicialización común para todos los tests
describe "Tests de Combate, Armas y HUD" {
  
  // Definimos variables ficticias (Mock objects) para las pruebas
  const animacionDummy = new Animador(frames = ["bala1.png", "bala2.png"])
  

  // Limpiamos y preparamos el entorno antes de cada test individual
  method initialize() {
    game.clear()
    game.width(10)
    game.height(10)
    
    // Reseteamos los estados del HUD y gestores
    hudPuntaje.puntaje(0)
    gestorDisparos.initialize() 
  }

  // ==========================================
  // 1. TEST DE ARMAS Y LÍMITES DEL GESTOR
  // ==========================================
  test "El gestor de disparos respeta el límite máximo por bando" {
    // Simulamos que se crean disparos enemigos hasta saturar el límite (tope = 2)
    const disparo1 = new Disparo(animacion = animacionDummy, dano = 10, velocidad = 5, bando = bandoEnemigo, position = game.at(1,1))
    const disparo2 = new Disparo(animacion = animacionDummy, dano = 10, velocidad = 5, bando = bandoEnemigo, position = game.at(1,2))
    const disparo3 = new Disparo(animacion = animacionDummy, dano = 10, velocidad = 5, bando = bandoEnemigo, position = game.at(1,2))
    const disparo4 = new Disparo(animacion = animacionDummy, dano = 10, velocidad = 5, bando = bandoEnemigo, position = game.at(1,2))
    const disparo5 = new Disparo(animacion = animacionDummy, dano = 10, velocidad = 5, bando = bandoEnemigo, position = game.at(1,2))
    
    gestorDisparos.registrarDisparo(disparo1, bandoEnemigo)
    gestorDisparos.registrarDisparo(disparo2, bandoEnemigo)
    gestorDisparos.registrarDisparo(disparo3, bandoEnemigo)
    gestorDisparos.registrarDisparo(disparo4, bandoEnemigo)
    gestorDisparos.registrarDisparo(disparo5, bandoEnemigo)

    // Verificamos que el bando enemigo ya no tenga permitido disparar
    assert.equals(false,gestorDisparos.puedeDisparar(bandoEnemigo))
  }

  test "El bando jugador no posee restricciones drásticas de disparo" {
    // Al jugador le configuramos límite de 5 balas
    assert.that(gestorDisparos.puedeDisparar(bandoJugador))
  }

  // ==========================================
  // 2. TEST DE DISPARO Y COLISIONES
  // ==========================================
  test "Un disparo genera daño al impactar a un bando contrario" {
    
    // Objeto objetivo ficticio para simular el impacto
    const enemigoFicticio = object {
      var property vida = 50
      method bando() = bandoEnemigo
      method recibirDano(cantidad) { vida -= cantidad }
    }

    const disparoAliado = new Disparo(
      animacion = animacionDummy, 
      dano = 15, 
      velocidad = 5, 
      bando = bandoJugador, 
      position = game.at(4,4)
    )

    // Simulamos el impacto directo invocando el método de colisión
    disparoAliado.colisionarCon(enemigoFicticio)

    // Verificaciones: el enemigo debió recibir daño y el disparo debió liberar su bando
    assert.equals(35, enemigoFicticio.vida())
  }

  // ==========================================
  // 3. TEST DEL HUD INTERACTIVO
  // ==========================================
  test "El HUD incrementa y refleja el puntaje de forma matemática" {
    // Simulamos que el juego suma puntos
    hudPuntaje.puntaje(100)
    
    // Verificamos que el string retornado por el HUD sea el correcto
    assert.equals("PUNTOS: 100", hudPuntaje.text())
  }
}
