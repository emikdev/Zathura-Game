import wollok.game.*
import src.menu.menu.*

program Zathura {

	// Dimensiones del tablero en celdas
	game.width(20)
	game.height(20)

	// Tamano de cada celda en px
	game.cellSize(256)

	// Titulo del juego
	game.title("Zathura Game")

	// saco el inicio del fondo de aca, ya que segun el menu que haya cambiara.

	// Se carga el menu
	menu.iniciar()	

	// Inicializador del juego
	game.start()

}