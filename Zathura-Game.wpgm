import wollok.game.*
import src.mapas.mapaDemo.*

program Zathura {

	// Dimensiones del tablero en celdas
	game.width(20)
	game.height(20)

	// Tamano de cada celda en px
	game.cellSize(256)

	// Titulo del juego
	game.title("Zathura Game")

	// Se define la imagen de fondo
	game.boardGround("fondo1Galaga.gif")

	// Cargar el nivel de la demo
	mapaDemo.cargar()

	// Inicializador del juego
	game.start()

}