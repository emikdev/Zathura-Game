import wollok.game.*
import src.menu.menu.*

program Zathura {

	// Dimensiones del tablero en celdas
	game.width(20)
	game.height(20)

	// Tamano de cada celda en px
	game.cellSize(256)

	// Titulo del juego
	game.title("Zathura Game")

	// Se inicia el primer fondo.
	game.boardGround("reglas2.png")

	// Se carga el menu
	menu.iniciar()	

	// Inicializador del juego
	game.start()

}